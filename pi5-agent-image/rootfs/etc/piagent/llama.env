# Settings for llama-server.service (chat) and llama-embed.service (embeddings).
# Apply changes with: sudo systemctl restart llama-server llama-embed

CHAT_MODEL=@CHAT_MODEL@
CHAT_CTX=4096
CHAT_THREADS=4

EMBED_MODEL=@EMBED_MODEL@
EMBED_CTX=512
EMBED_THREADS=2
# bge models use CLS pooling; use "mean" for e.g. nomic-embed or all-MiniLM.
EMBED_POOLING=cls
