[Unit]
Description=llama.cpp embedding server (bge-small-en-v1.5, loopback only)
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server
After=local-fs.target

[Service]
Type=simple
User=llama
Group=llama
EnvironmentFile=/etc/piagent/llama.env
ExecStart=/opt/llama.cpp/bin/llama-server \
    --model ${EMBED_MODEL} --alias bge-small-en-v1.5 \
    --embeddings --pooling ${EMBED_POOLING} \
    --ctx-size ${EMBED_CTX} --batch-size ${EMBED_CTX} --ubatch-size ${EMBED_CTX} \
    --parallel 1 --threads ${EMBED_THREADS} --no-webui \
    --host 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=5
Nice=10

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
