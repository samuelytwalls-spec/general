#!/bin/bash
# Undoes net-up: firewall table, AP address, virtual interface, forwarding.
set -uo pipefail

PIGW_LIB=${PIGW_LIB:-/usr/local/lib/pi-gateway}
# shellcheck source=common.sh
source "$PIGW_LIB/common.sh"
load_config

nft delete table inet pigw 2>/dev/null

if [[ -d /sys/class/net/$AP_IFACE ]]; then
    ip addr flush dev "$AP_IFACE" 2>/dev/null
    if is_yes "$AP_VIRTUAL"; then
        iw dev "$AP_IFACE" del 2>/dev/null
    else
        ip link set "$AP_IFACE" down 2>/dev/null
    fi
fi

if [[ -r $PIGW_RUN/ip_forward.prev ]]; then
    sysctl -q -w "net.ipv4.ip_forward=$(cat "$PIGW_RUN/ip_forward.prev")"
    rm -f "$PIGW_RUN/ip_forward.prev"
fi

exit 0
