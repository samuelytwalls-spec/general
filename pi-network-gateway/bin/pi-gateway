#!/bin/bash
# pi-gateway: manage the hidden access point that routes through this Pi.
set -euo pipefail

PIGW_LIB=${PIGW_LIB:-/usr/local/lib/pi-gateway}
# shellcheck source=../lib/common.sh
source "$PIGW_LIB/common.sh"

UNITS=(pi-gateway-net pi-gateway-hostapd pi-gateway-dhcp)

usage() {
    cat <<'EOF'
Usage: pi-gateway <command>

  status               Service state, addresses and client count
  clients              Devices connected to the hidden network
  start | stop | restart
  logs                 Follow the gateway logs
  qr                   Show a QR code to join the hidden network
  set-password [PW]    Change the Wi-Fi password (prompts if PW omitted)
  set-ssid NAME        Change the network name
  hidden on|off        Hide or broadcast the network name
  kick MAC             Disconnect a device (it may reconnect)
  pihole on|off        Turn Pi-hole DNS filtering on or off
  config               Edit gateway.conf, validate and restart
  check                Validate gateway.conf
EOF
}

need_root() { ((EUID == 0)) || exec sudo -- "$0" "$@"; }

restart() {
    load_config
    validate_config
    systemctl restart pi-gateway.target
    sleep 2
    status
}

status() {
    load_config
    local u state
    printf 'Services:\n'
    for u in "${UNITS[@]}"; do
        state=$(systemctl is-active "$u.service" 2>/dev/null || true)
        printf '  %-22s %s\n' "$u" "$state"
    done
    if is_yes "$PIHOLE"; then
        printf '  %-22s %s\n' pihole-FTL "$(systemctl is-active pihole-FTL.service 2>/dev/null || true)"
    fi

    local up_addr
    up_addr=$(ip -4 -o addr show dev "$UPSTREAM_IFACE" 2>/dev/null | awk '{ print $4; exit }')
    printf '\nNetwork:\n'
    printf '  SSID        %s (%s)\n' "$AP_SSID" "$(is_yes "$AP_HIDDEN" && echo hidden || echo broadcast)"
    printf '  Security    %s\n' "$AP_SECURITY"
    printf '  AP          %s  %s/%s\n' "$AP_IFACE" "$LAN_ADDRESS" "$LAN_PREFIX"
    printf '  Upstream    %s  %s\n' "$UPSTREAM_IFACE" "${up_addr:-no address}"
    printf '  Gateway     %s\n' "$(ip -4 route show default 2>/dev/null | awk '{ print $3 " via " $5; exit }')"
    printf '  DNS         %s\n' "$(is_yes "$PIHOLE" && echo "Pi-hole (http://$LAN_ADDRESS/admin)" || echo "dnsmasq -> ${UPSTREAM_DNS:-system resolvers}")"
    if [[ -S $PIGW_RUN/hostapd/$AP_IFACE ]]; then
        local channel n apstat apstate
        apstat=$(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" status 2>/dev/null || true)
        channel=$(awk -F= '$1 == "channel" { print $2 }' <<<"$apstat")
        apstate=$(awk -F= '$1 == "state" { print $2 }' <<<"$apstat")
        if [[ $apstate == ENABLED ]]; then
            printf '  AP state    broadcasting\n'
        else
            printf '  AP state    %s - NOT broadcasting (see: sudo journalctl -u pi-gateway-net -u pi-gateway-hostapd -b)\n' "${apstate:-unknown}"
        fi
        n=$(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" list_sta 2>/dev/null | grep -c . || true)
        printf '  Channel     %s\n' "${channel:-?}"
        printf '  Clients     %s\n' "$n"
    fi
}

clients() {
    load_config
    [[ -S $PIGW_RUN/hostapd/$AP_IFACE ]] || die "access point is not running"
    local leases=$PIGW_STATE/dnsmasq.leases mac ip name info signal
    printf '%-18s %-16s %-24s %s\n' MAC IP HOSTNAME SIGNAL
    while read -r mac; do
        [[ -n $mac ]] || continue
        ip="" name=""
        if [[ -r $leases ]]; then
            read -r ip name < <(awk -v m="$mac" 'tolower($2) == tolower(m) { print $3, $4 }' "$leases") || true
        fi
        info=$(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" sta "$mac" 2>/dev/null || true)
        signal=$(awk -F= '$1 == "signal" { print $2 " dBm" }' <<<"$info")
        printf '%-18s %-16s %-24s %s\n' "$mac" "${ip:--}" "${name:--}" "${signal:--}"
    done < <(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" list_sta 2>/dev/null)
}

qr() {
    load_config
    command -v qrencode >/dev/null || die "qrencode is not installed (apt install qrencode)"
    # Escape \ ; , : " as required by the WIFI: URI format.
    # shellcheck disable=SC2001
    esc() { sed -e 's/[\\;,:"]/\\&/g' <<<"$1"; }
    local t=WPA uri
    [[ $AP_SECURITY == wpa3 ]] && t=SAE
    uri="WIFI:T:$t;S:$(esc "$AP_SSID");P:$(esc "$AP_PASSWORD");"
    is_yes "$AP_HIDDEN" && uri+="H:true;"
    uri+=";"
    qrencode -t ansiutf8 "$uri"
    printf 'SSID: %s   (hidden networks must be added manually or via this QR code)\n' "$AP_SSID"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
    status)  need_root "$cmd" "$@"; status ;;
    clients) need_root "$cmd" "$@"; clients ;;
    start)   need_root "$cmd" "$@"; load_config; validate_config; systemctl start pi-gateway.target; status ;;
    stop)    need_root "$cmd" "$@"; systemctl stop pi-gateway.target "${UNITS[@]/%/.service}" ;;
    restart) need_root "$cmd" "$@"; restart ;;
    logs)    exec journalctl -f -u 'pi-gateway-*' ;;
    qr)      need_root "$cmd" "$@"; qr ;;
    check)   need_root "$cmd" "$@"; load_config; validate_config; log "config OK" ;;
    set-password)
        need_root "$cmd" "$@"
        pw=${1:-}
        if [[ -z $pw ]]; then
            read -r -s -p "New Wi-Fi password (8-63 chars): " pw; echo
            read -r -s -p "Repeat: " pw2; echo
            [[ $pw == "$pw2" ]] || die "passwords do not match"
        fi
        (( ${#pw} >= 8 && ${#pw} <= 63 )) || die "password must be 8-63 characters"
        set_conf_value AP_PASSWORD "$pw"
        restart ;;
    set-ssid)
        need_root "$cmd" "$@"
        [[ -n ${1:-} ]] || die "usage: pi-gateway set-ssid NAME"
        set_conf_value AP_SSID "$1"
        restart ;;
    hidden)
        need_root "$cmd" "$@"
        case ${1:-} in
            on)  set_conf_value AP_HIDDEN yes ;;
            off) set_conf_value AP_HIDDEN no ;;
            *) die "usage: pi-gateway hidden on|off" ;;
        esac
        restart ;;
    kick)
        need_root "$cmd" "$@"
        load_config
        [[ ${1:-} =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || die "usage: pi-gateway kick MAC"
        hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" deauthenticate "$1" ;;
    pihole)
        need_root "$cmd" "$@"
        case ${1:-} in
            on)  set_conf_value PIHOLE yes
                 # Free port 53 on the AP before Pi-hole takes over DNS.
                 systemctl stop pi-gateway-dhcp.service || true
                 "$PIGW_LIB/pihole-setup" enable ;;
            off) set_conf_value PIHOLE no;  "$PIGW_LIB/pihole-setup" disable ;;
            *) die "usage: pi-gateway pihole on|off" ;;
        esac
        restart ;;
    config)
        need_root "$cmd" "$@"
        "${EDITOR:-nano}" "$PIGW_CONF"
        restart ;;
    ""|-h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
