#!/bin/bash
# pi-gateway: manage the hidden access point that routes through this Pi.
set -euo pipefail

PIGW_LIB=${PIGW_LIB:-/usr/local/lib/pi-gateway}
# shellcheck source=../lib/common.sh
source "$PIGW_LIB/common.sh"

UNITS=(pi-gateway-net pi-gateway-hostapd pi-gateway-dhcp)

usage() {
    cat <<'EOF'
Usage: pi-gateway <command>

  status               Service state, addresses and client count
  clients              Devices connected to the hidden network
  start | stop | restart
  logs                 Follow the gateway logs
  qr                   Show a QR code to join the hidden network
  set-password [PW]    Change the Wi-Fi password (prompts if PW omitted)
  set-ssid NAME        Change the network name
  hidden on|off        Hide or broadcast the network name
  kick MAC             Disconnect a device (it may reconnect)
  pihole on|off        Turn Pi-hole DNS filtering on or off
  config               Edit gateway.conf, validate and restart
  check                Validate gateway.conf
  diag                 Collect logs and settings into one file for troubleshooting
                       (passwords removed)
EOF
}

need_root() { ((EUID == 0)) || exec sudo -- "$0" "$@"; }

restart() {
    load_config
    validate_config
    systemctl restart pi-gateway.target
    sleep 2
    status
}

status() {
    load_config
    local u state
    printf 'Services:\n'
    for u in "${UNITS[@]}"; do
        state=$(systemctl is-active "$u.service" 2>/dev/null || true)
        printf '  %-22s %s\n' "$u" "$state"
    done
    # Show why the network setup step failed, straight from its log.
    if [[ $(systemctl is-active pi-gateway-net.service 2>/dev/null) == failed ]]; then
        local why lines
        why=$(journalctl -b -u pi-gateway-net.service -o cat --no-pager 2>/dev/null \
              | grep -E 'ERROR|config error' | tail -n 3)
        printf '\n  pi-gateway-net failed because:\n'
        mapfile -t lines <<<"${why:-(no error recorded - see: sudo journalctl -u pi-gateway-net -b)}"
        printf '    %s\n' "${lines[@]}"
    fi
    if is_yes "$PIHOLE"; then
        printf '  %-22s %s\n' pihole-FTL "$(systemctl is-active pihole-FTL.service 2>/dev/null || true)"
    fi

    local up_addr
    up_addr=$(ip -4 -o addr show dev "$UPSTREAM_IFACE" 2>/dev/null | awk '{ print $4; exit }')
    printf '\nNetwork:\n'
    if is_wifi_link; then
        printf '  SSID        %s (%s)\n' "$AP_SSID" "$(is_yes "$AP_HIDDEN" && echo hidden || echo broadcast)"
        printf '  Security    %s\n' "$AP_SECURITY"
        printf '  AP          %s  %s/%s\n' "$AP_IFACE" "$LAN_ADDRESS" "$LAN_PREFIX"
    else
        local cable=unplugged
        [[ $(cat "/sys/class/net/$AP_IFACE/carrier" 2>/dev/null) == 1 ]] && cable=connected
        printf '  Client link %s cable on %s  %s/%s  (%s)\n' "$CLIENT_LINK" "$AP_IFACE" "$LAN_ADDRESS" "$LAN_PREFIX" "$cable"
    fi
    printf '  Upstream    %s  %s\n' "$UPSTREAM_IFACE" "${up_addr:-no address}"
    printf '  Gateway     %s\n' "$(ip -4 route show default 2>/dev/null | awk '{ print $3 " via " $5; exit }')"
    printf '  DNS         %s\n' "$(is_yes "$PIHOLE" && echo "Pi-hole (http://$LAN_ADDRESS/admin)" || echo "dnsmasq -> ${UPSTREAM_DNS:-system resolvers}")"
    if [[ -S $PIGW_RUN/hostapd/$AP_IFACE ]]; then
        local channel n apstat apstate
        apstat=$(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" status 2>/dev/null || true)
        channel=$(awk -F= '$1 == "channel" { print $2 }' <<<"$apstat")
        apstate=$(awk -F= '$1 == "state" { print $2 }' <<<"$apstat")
        if [[ $apstate == ENABLED ]]; then
            printf '  AP state    broadcasting\n'
        else
            printf '  AP state    %s - NOT broadcasting (see: sudo journalctl -u pi-gateway-net -u pi-gateway-hostapd -b)\n' "${apstate:-unknown}"
        fi
        n=$(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" list_sta 2>/dev/null | grep -c . || true)
        printf '  Channel     %s\n' "${channel:-?}"
        printf '  Clients     %s\n' "$n"
    fi
    # Powered from a computer's USB port, the Pi 5 can run short of power.
    if [[ $CLIENT_LINK == usb ]] && command -v vcgencmd >/dev/null; then
        local thr
        thr=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2)
        if [[ $thr == 0x0 ]]; then
            printf '  Power       OK\n'
        else
            printf '  Power       UNDER-VOLTAGE/THROTTLING (%s) - use a stronger USB port (USB-C, 3 A)\n' "${thr:-?}"
        fi
    fi
}

wifi_only() { is_wifi_link || die "this command is for the Wi-Fi network; CLIENT_LINK is $CLIENT_LINK"; }

clients() {
    load_config
    local leases=$PIGW_STATE/dnsmasq.leases mac ip name info signal
    if ! is_wifi_link; then
        # No access point to ask; show who holds a DHCP lease.
        printf '%-18s %-16s %s\n' MAC IP HOSTNAME
        [[ -r $leases ]] && awk '{ printf "%-18s %-16s %s\n", $2, $3, $4 }' "$leases"
        return 0
    fi
    [[ -S $PIGW_RUN/hostapd/$AP_IFACE ]] || die "access point is not running"
    printf '%-18s %-16s %-24s %s\n' MAC IP HOSTNAME SIGNAL
    while read -r mac; do
        [[ -n $mac ]] || continue
        ip="" name=""
        if [[ -r $leases ]]; then
            read -r ip name < <(awk -v m="$mac" 'tolower($2) == tolower(m) { print $3, $4 }' "$leases") || true
        fi
        info=$(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" sta "$mac" 2>/dev/null || true)
        signal=$(awk -F= '$1 == "signal" { print $2 " dBm" }' <<<"$info")
        printf '%-18s %-16s %-24s %s\n' "$mac" "${ip:--}" "${name:--}" "${signal:--}"
    done < <(hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" list_sta 2>/dev/null)
}

qr() {
    load_config
    wifi_only
    command -v qrencode >/dev/null || die "qrencode is not installed (apt install qrencode)"
    # Escape \ ; , : " as required by the WIFI: URI format.
    # shellcheck disable=SC2001
    esc() { sed -e 's/[\\;,:"]/\\&/g' <<<"$1"; }
    local t=WPA uri
    [[ $AP_SECURITY == wpa3 ]] && t=SAE
    uri="WIFI:T:$t;S:$(esc "$AP_SSID");P:$(esc "$AP_PASSWORD");"
    is_yes "$AP_HIDDEN" && uri+="H:true;"
    uri+=";"
    qrencode -t ansiutf8 "$uri"
    printf 'SSID: %s   (hidden networks must be added manually or via this QR code)\n' "$AP_SSID"
}

# Everything needed to work out why devices can't connect, in one file.
diag() {
    local out
    out="$PWD/pi-gateway-diag-$(date +%Y%m%d-%H%M%S).txt"
    [[ -w $PWD ]] || out="/tmp/${out##*/}"

    run() {  # run "title" command...
        printf '\n===== %s =====\n$ %s\n' "$1" "${*:2}"
        timeout 20 "${@:2}" 2>&1 || printf '(exit %s)\n' "$?"
    }
    redact() {
        sed -E -e 's/^((AP_PASSWORD|PIHOLE_WEB_PASSWORD)=).*/\1<removed>/' \
               -e 's/^((wpa_passphrase|sae_password)=).*/\1<removed>/'
    }

    log "collecting diagnostics (about 15 s)..."
    {
        echo "pi-gateway diagnostics, $(date -Is)"
        run "model" cat /proc/device-tree/model
        run "os" cat /etc/os-release
        run "kernel" uname -a
        run "uptime" uptime
        run "power / throttling (0x0 = OK)" vcgencmd get_throttled

        echo; echo "===== status ====="
        status 2>&1 || true

        echo; echo "===== gateway.conf (passwords removed) ====="
        redact <"$PIGW_CONF"
        echo; echo "===== generated hostapd.conf (passwords removed) ====="
        if [[ -r $PIGW_RUN/hostapd.conf ]]; then redact <"$PIGW_RUN/hostapd.conf"; else echo "(none - not Wi-Fi mode, or net-up failed)"; fi
        run "generated dnsmasq.conf" cat "$PIGW_RUN/dnsmasq.conf"

        run "services" systemctl --no-pager status pi-gateway.target pi-gateway-net pi-gateway-hostapd pi-gateway-dhcp pi-gateway-watch.timer
        run "gateway journal (this boot, last 300 lines)" journalctl -b --no-pager -n 300 -u 'pi-gateway-*'
        run "install log (last 80 lines)" tail -n 80 /var/log/pi-gateway-install.log

        if is_wifi_link; then
            run "hostapd state" hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" status
            run "connected stations" hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" all_sta
            run "wireless interfaces" iw dev
            run "upstream link" iw dev "$UPSTREAM_IFACE" link
            run "regulatory domain" iw reg get
            run "radio capabilities (modes, combinations)" sh -c "iw list | sed -n '/Supported interface modes/,/^\t[A-Z]/p;/valid interface combinations/,/^\t[A-Z]/p'"
            run "rfkill" rfkill list
        else
            run "USB device controller (must not be empty in usb mode)" ls -l /sys/class/udc
            run "USB gadget" sh -c "ls -R /sys/kernel/config/usb_gadget 2>&1 | head -60"
            run "boot config overlays" grep -nE '^\s*(\[|dtoverlay)' /boot/firmware/config.txt
            run "bridge" bridge link
        fi

        run "addresses" ip -4 addr
        run "routes" ip -4 route
        run "IPv4 forwarding (must be 1)" sysctl net.ipv4.ip_forward
        run "firewall (all tables)" nft list ruleset
        run "DHCP leases" cat "$PIGW_STATE/dnsmasq.leases"
        run "listening sockets (53 DNS, 67 DHCP)" ss -lunp
        run "NetworkManager devices" nmcli -f DEVICE,TYPE,STATE,CONNECTION device
        run "internet from the Pi" ping -c 2 -W 2 1.1.1.1
        run "DNS from the Pi" getent hosts example.com
        run "kernel Wi-Fi/USB messages" sh -c "dmesg | grep -iE 'brcmf|cfg80211|dwc2|gadget|usb0|under-voltage' | tail -n 80"
    } >"$out" 2>&1
    chmod 644 "$out"
    log "saved: $out"
    echo "Show it with:  cat $out"
    echo "Or copy it to Windows (run on the PC):  scp user@<pi-ip>:$out ."
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
    status)  need_root "$cmd" "$@"; status ;;
    clients) need_root "$cmd" "$@"; clients ;;
    start)   need_root "$cmd" "$@"; load_config; validate_config; systemctl start pi-gateway.target; status ;;
    stop)    need_root "$cmd" "$@"; systemctl stop pi-gateway.target "${UNITS[@]/%/.service}" ;;
    restart) need_root "$cmd" "$@"; restart ;;
    logs)    exec journalctl -f -u 'pi-gateway-*' ;;
    diag)    need_root "$cmd" "$@"; load_config; diag ;;
    qr)      need_root "$cmd" "$@"; qr ;;
    check)   need_root "$cmd" "$@"; load_config; validate_config; log "config OK" ;;
    set-password)
        need_root "$cmd" "$@"
        load_config; wifi_only
        pw=${1:-}
        if [[ -z $pw ]]; then
            read -r -s -p "New Wi-Fi password (8-63 chars): " pw; echo
            read -r -s -p "Repeat: " pw2; echo
            [[ $pw == "$pw2" ]] || die "passwords do not match"
        fi
        (( ${#pw} >= 8 && ${#pw} <= 63 )) || die "password must be 8-63 characters"
        set_conf_value AP_PASSWORD "$pw"
        restart ;;
    set-ssid)
        need_root "$cmd" "$@"
        load_config; wifi_only
        [[ -n ${1:-} ]] || die "usage: pi-gateway set-ssid NAME"
        set_conf_value AP_SSID "$1"
        restart ;;
    hidden)
        need_root "$cmd" "$@"
        load_config; wifi_only
        case ${1:-} in
            on)  set_conf_value AP_HIDDEN yes ;;
            off) set_conf_value AP_HIDDEN no ;;
            *) die "usage: pi-gateway hidden on|off" ;;
        esac
        restart ;;
    kick)
        need_root "$cmd" "$@"
        load_config; wifi_only
        load_config
        [[ ${1:-} =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || die "usage: pi-gateway kick MAC"
        hostapd_cli -p "$PIGW_RUN/hostapd" -i "$AP_IFACE" deauthenticate "$1" ;;
    pihole)
        need_root "$cmd" "$@"
        case ${1:-} in
            on)  set_conf_value PIHOLE yes
                 # Free port 53 on the AP before Pi-hole takes over DNS.
                 systemctl stop pi-gateway-dhcp.service || true
                 "$PIGW_LIB/pihole-setup" enable ;;
            off) set_conf_value PIHOLE no;  "$PIGW_LIB/pihole-setup" disable ;;
            *) die "usage: pi-gateway pihole on|off" ;;
        esac
        restart ;;
    config)
        need_root "$cmd" "$@"
        "${EDITOR:-nano}" "$PIGW_CONF"
        restart ;;
    ""|-h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
